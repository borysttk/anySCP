# Generated by Cargo
# will have compiled files and executables
/target/

# Generated by Tauri
# will have schema files for capabilities auto-completion
/gen/schemas

# Generated by `tauri android init` — the whole Gradle project is regenerated
# output. The anySCP-specific Kotlin sources are version-controlled in
# src-tauri/android/ and copied in by `make android-sync`.
/gen/android

# Android signing material — must never be committed.
/gen/android/keystore.properties
*.jks
*.keystore
